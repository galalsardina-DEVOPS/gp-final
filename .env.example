SERVICE_MODE=hybrid
REMOTE_ENDPOINT_URL=https://your-aws-endpoint.example.com/predict
REMOTE_API_KEY=
REMOTE_TIMEOUT_SECONDS=3.0
NETWORK_PROBE_URL=https://aws.amazon.com
NETWORK_PROBE_TIMEOUT_SECONDS=1.2
NETWORK_PROBE_TTL_SECONDS=5

LOCAL_MODEL_BACKEND=keras
LOCAL_MODEL_PATH=./drowsy_model.h5
LOCAL_MODEL_THRESHOLD=0.65
MODEL_INPUT_WIDTH=224
MODEL_INPUT_HEIGHT=224

DATASET_PATH=./data/train_data
TRAIN_OUTPUT_ROOT=./artifacts/runs
TRAIN_MODEL_TYPE=simple
TRAIN_BASE_WEIGHTS=none
TRAIN_EPOCHS=10
TRAIN_BATCH_SIZE=32
TRAIN_VALIDATION_SPLIT=0.2
TRAIN_LEARNING_RATE=0.001
TRAIN_RANDOM_SEED=42
TRAIN_MIN_PROMOTE_ACCURACY=0.75
TRAIN_PROMOTE_DELTA=0.01

FRAME_SKIP=3
CNN_EVERY_N_FRAMES=25
EAR_CLOSED_THRESHOLD=0.19
EAR_COOLDOWN_STEP=3
EAR_ALARM_FRAMES=35
MAR_OPEN_THRESHOLD=0.65
YAWN_COOLDOWN_STEP=2
YAWN_ALARM_FRAMES=20
FUSION_EAR_GATE=0.23
ALARM_AUDIO_PATH=./alarm.wav
