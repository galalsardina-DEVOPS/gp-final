SERVICE_MODE=hybrid
REMOTE_ENDPOINT_URL=https://your-aws-endpoint.example.com/predict
REMOTE_API_KEY=
REMOTE_TIMEOUT_SECONDS=3.0
NETWORK_PROBE_URL=https://aws.amazon.com
NETWORK_PROBE_TIMEOUT_SECONDS=1.2
NETWORK_PROBE_TTL_SECONDS=5

LOCAL_MODEL_BACKEND=keras
LOCAL_MODEL_PATH=./drowsy_model.h5
LOCAL_MODEL_THRESHOLD=0.65
MODEL_INPUT_WIDTH=224
MODEL_INPUT_HEIGHT=224

DATASET_PATH=./data/train_data
TRAIN_OUTPUT_ROOT=./artifacts/runs
TRAIN_MODEL_TYPE=mobilenet
TRAIN_BASE_WEIGHTS=imagenet
TRAIN_EPOCHS=10
TRAIN_FINE_TUNE_EPOCHS=4
TRAIN_FINE_TUNE_LAYERS=20
TRAIN_BATCH_SIZE=32
TRAIN_VALIDATION_SPLIT=0.2
TRAIN_LEARNING_RATE=0.0005
TRAIN_FINE_TUNE_LEARNING_RATE=0.00005
TRAIN_AUGMENTATION_ENABLED=true
TRAIN_CLASS_WEIGHT_ENABLED=true
TRAIN_EARLY_STOPPING_PATIENCE=4
TRAIN_RANDOM_SEED=42
TRAIN_MIN_PROMOTE_ACCURACY=0.55
TRAIN_PROMOTE_DELTA=0.01

FRAME_SKIP=3
CNN_EVERY_N_FRAMES=25
EAR_CLOSED_THRESHOLD=0.19
EAR_COOLDOWN_STEP=3
EAR_ALARM_FRAMES=35
MAR_OPEN_THRESHOLD=0.65
YAWN_COOLDOWN_STEP=2
YAWN_ALARM_FRAMES=20
FUSION_EAR_GATE=0.23
ALARM_AUDIO_PATH=./alarm.wav

EVENT_DB_PATH=./artifacts/events.db
DROWSY_EVENT_COOLDOWN_SECONDS=10
DROWSY_FRAME_CAPTURE_ENABLED=true
DROWSY_FRAME_DIR=./artifacts/drowsy_frames
S3_UPLOAD_ENABLED=false
S3_BUCKET=
S3_PREFIX=drowsy-events
